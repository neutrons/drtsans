#!/bin/bash
# Bash completion for drtsans.gpr module
#
# Installation:
#   Add to your ~/.bashrc or ~/.bash_profile:
#     eval "$(register-python-argcomplete drtsans-gpr)"
#
# Or source this file directly:
#     source /path/to/drtsans-gpr.bashcomplete
#
# Note: Requires argcomplete to be installed:
#     pixi run pip install argcomplete

eval "$(register-python-argcomplete drtsans-gpr)"
